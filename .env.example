# ─────────────────────────────────────────────────────────────────────────────
# Brand House — environment variables
# Copy to .env.local for local development. On Vercel, add these under
# Project → Settings → Environment Variables. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# Public site URL used for canonical links, sitemap and social previews.
# Usually leave this EMPTY on Vercel: the site then uses the project's
# production domain automatically (the vercel.app address today, and
# brandhouse.co.ke as soon as that domain is connected).
NEXT_PUBLIC_SITE_URL=

# Optional override for the public email (default brandhouse254@gmail.com, set in src/config/site.ts).
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Contact form delivery (server-only, required for the form to send) ──────
# 1. Create an account at https://resend.com
# 2. Verify the brandhouse.co.ke domain in Resend (adds DNS records)
# 3. Create an API key with "Sending access"
RESEND_API_KEY=
# Inbox that receives enquiries. Separate several with commas.
CONTACT_TO_EMAIL=brandhouse254@gmail.com
# Verified sender on your domain, e.g. Brand House <enquiries@brandhouse.co.ke>
CONTACT_FROM_EMAIL=

# ── Analytics (optional, both cookieless) ───────────────────────────────────
# Set to 1 to load Vercel Web Analytics (also enable it in the Vercel dashboard).
NEXT_PUBLIC_VERCEL_ANALYTICS=
# Your Plausible site domain, e.g. brandhouse.co.ke
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ── Indexing (only needed when NOT hosting on Vercel) ────────────────────────
# On Vercel, only the production deployment is indexable automatically.
# Elsewhere, set to true on the production server only.
SITE_INDEXABLE=
